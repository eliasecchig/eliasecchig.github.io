---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 6);
const [featured, ...rest] = posts;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main" class="wrap page">
			<div class="prose">
				<h1>{SITE_TITLE}</h1>
				<p>
					{SITE_DESCRIPTION} I work at Google, and the views here are my own. <a href="/about/">More about me</a>.
				</p>
				<h2 class="section-title">Latest post</h2>
				{
					featured && (
						<article class="featured">
							<a class="featured-media" href={`/blog/${featured.id}/`} tabindex="-1" aria-hidden="true">
								{featured.data.hero && (
									<Image
										src={featured.data.hero}
										alt=""
										width={1360}
										sizes="(min-width: 760px) 680px, 100vw"
										loading="eager"
									/>
								)}
							</a>
							<FormattedDate date={featured.data.date} />
							<h3>
								<a href={`/blog/${featured.id}/`}>{featured.data.title}</a>
							</h3>
							<p>{featured.data.description}</p>
							{featured.data.tags.length > 0 && (
								<p class="tags">{featured.data.tags.slice(0, 3).join(' · ')}</p>
							)}
						</article>
					)
				}
				{
					rest.length > 0 && (
						<>
							<h2 class="section-title more">More posts</h2>
							<ul class="home-posts">
								{rest.map((post) => (
									<li class="home-post">
										{post.data.hero && (
											<Image
												class="thumb"
												src={post.data.hero}
												alt=""
												width={320}
												loading="lazy"
											/>
										)}
										<div class="home-post-text">
											<FormattedDate date={post.data.date} />
											<h3>
												<a href={`/blog/${post.id}/`}>{post.data.title}</a>
											</h3>
											<p>{post.data.description}</p>
										</div>
									</li>
								))}
							</ul>
						</>
					)
				}
				<p class="all-posts"><a href="/blog/">All posts <span aria-hidden="true">→</span></a></p>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.section-title {
		margin: 56px 0 24px;
		padding-bottom: 12px;
		font-size: 14px;
		line-height: 1;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-3);
		border-bottom: 1px solid var(--rule);
	}
	.section-title.more {
		margin-top: 48px;
		margin-bottom: 0;
	}
	/* shared card parts: the title link stretches over the whole card */
	.featured,
	.home-post {
		position: relative;
	}
	.featured :global(time),
	.home-post :global(time) {
		display: block;
		margin-bottom: 6px;
		font-size: 13px;
		color: var(--ink-3);
	}
	.featured h3,
	.home-post h3 {
		margin: 0 0 8px;
		line-height: 1.25;
	}
	.featured h3 a,
	.home-post h3 a {
		color: var(--ink);
		text-decoration: none;
	}
	.featured h3 a::after,
	.home-post h3 a::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.featured:hover h3 a,
	.home-post:hover h3 a {
		color: var(--accent);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 4px;
	}
	.featured h3 a:focus-visible,
	.home-post h3 a:focus-visible {
		outline: none;
	}
	.featured:has(h3 a:focus-visible),
	.home-post:has(h3 a:focus-visible) {
		outline: 2px solid var(--blue);
		outline-offset: 8px;
		border-radius: 6px;
	}

	.featured-media {
		display: block;
		margin-bottom: 20px;
		border: 1px solid var(--rule);
		border-radius: 12px;
		background: var(--surface);
		overflow: hidden;
	}
	.featured-media :global(img) {
		display: block;
		width: 100%;
		height: auto;
		max-height: 360px;
		margin: 0;
		padding: 0 !important; /* beats the dark-mode .prose img padding */
		border-radius: 0;
		object-fit: contain;
	}
	.featured h3 {
		font-size: clamp(26px, 3vw, 32px);
		letter-spacing: -0.015em;
	}
	.featured p {
		margin: 0;
		font-size: 17px;
		line-height: 1.55;
		color: var(--ink-2);
	}
	.featured p.tags {
		margin-top: 12px;
		font-family: var(--code);
		font-size: 12.5px;
		color: var(--ink-3);
	}

	.home-posts {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.home-post {
		display: flex;
		align-items: flex-start;
		gap: 24px;
		margin: 0;
		padding: 24px 0;
		border-bottom: 1px solid var(--rule);
	}
	.home-post + .home-post {
		margin-top: 0;
	}
	.home-post .thumb {
		flex: none;
		order: 2;
		width: 128px;
		height: 88px;
		margin: 2px 0 0;
		padding: 0 !important;
		border: 1px solid var(--rule);
		border-radius: 8px;
		background: #fff;
		object-fit: cover;
	}
	.home-post-text {
		flex: 1;
		min-width: 0;
	}
	.home-post h3 {
		font-size: 20px;
		letter-spacing: -0.01em;
	}
	.home-post p {
		margin: 0;
		font-size: 15.5px;
		line-height: 1.55;
		color: var(--ink-2);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.all-posts {
		margin: 24px 0 0;
		font-size: 16px;
		font-weight: 500;
	}
	@media (max-width: 560px) {
		.section-title {
			margin-top: 40px;
		}
		.home-post {
			gap: 16px;
		}
		.home-post .thumb {
			width: 88px;
			height: 64px;
		}
		.home-post h3 {
			font-size: 18px;
		}
	}
</style>
