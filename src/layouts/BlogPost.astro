---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = {
	title: string;
	description: string;
	date: Date;
	updatedDate?: Date;
	hero?: ImageMetadata;
	hero_alt?: string;
};

const { title, description, date, updatedDate, hero, hero_alt } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={hero} />
	</head>

	<body>
		<Header />
		<main id="main" class="wrap page">
			<article class="prose">
				<p class="date">
					<FormattedDate date={date} />
					{
						updatedDate && (
							<span class="updated-on">
								Updated <FormattedDate date={updatedDate} />
							</span>
						)
					}
				</p>
				<h1>{title}</h1>
				<p>{description}</p>
				{hero && <Image width={1020} src={hero} alt={hero_alt ?? ''} />}
				<slot />
			</article>
		</main>
		<Footer />
	</body>
</html>
